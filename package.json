{
  "name": "math-riddles-app",
  "version": "1.0.0",
  "description": "Math Riddles Application",
  "main": "index.html",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "npx serve dist",
    "build": "mkdir -p dist && cp index.html styles.css script.js bg-music.mp3 correct-answer.mp3 wrong-answer.mp3 dist/",
    "sync": "npm run build && npx cap sync android",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor-community/admob": "^6.0.0",
    "@capacitor-community/in-app-purchases": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
